# Copy to `.env` (git-ignored) and adjust per environment.

# Global API prefix — see docs/backend/Design.md
VITE_API_URL=/api/v1

# Demo API. Left unset or 'true', every request is answered from src/data by
# src/services/mockAdapter.ts. Set to 'false' to call VITE_API_URL for real.
VITE_ENABLE_MOCKS=true
