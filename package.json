{
  "name": "school-flow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "School Flow AI — React frontend and API.",
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  },
  "config": {
    "commitizen": {
      "path": "./scripts/cz-commitlint-emoji.mjs"
    }
  }
}
