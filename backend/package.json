{
  "name": "school-flow-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "School Management System backend (NestJS + Prisma + PostgreSQL/Supabase)",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/platform-express": "^11.0.2",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.15.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.8.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.15",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/testing": "^11.0.2",
    "@types/bcrypt": "^3.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^6.1.13",
    "@types/passport-jwt": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@typescript-eslint/utils": "^8.42.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "prisma": "^6.15.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
