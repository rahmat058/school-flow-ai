    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/utils": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  }
