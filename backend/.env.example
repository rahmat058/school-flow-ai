# Copy to `.env` and fill in: `cp .env.example .env`
# `.env` is git-ignored — this file is the committed template, so keep every value empty.

PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase — Project Settings → API Keys.
# SUPABASE_PUBLISHABLE_KEY is the client-safe key (the former anon key).
# SUPABASE_SECRET_KEY is server-only and bypasses RLS — never expose it to the client.
SUPABASE_URL=https://[project].supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://[project].supabase.co/auth/v1/.well-known/jwks.json

# Tokens this API signs: access 15m, refresh 7d.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary — study material uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email (React Email templates rendered to HTML).
RESEND_API_KEY=
RESEND_FROM=

# Payments: Stripe (international) + SSLCommerz (Bangladesh).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# AI assistant, and the BullMQ/Redis queue behind email + reminders.
AI_API_KEY=
REDIS_URL=
