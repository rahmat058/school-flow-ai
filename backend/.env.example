# Copy to `.env` and fill in: `cp .env.example .env`
# `.env` is git-ignored — this file is the committed template, so keep every secret empty.
# The non-secret defaults (PORT, CLIENT_URL, SSLCOMMERZ_IS_SANDBOX) are ready to use as-is.
#
# Consumed today by `src/`: PORT, CLIENT_URL, DATABASE_URL, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, RESEND_API_KEY, RESEND_FROM. The rest are declared here for the
# phases that wire them (Cloudinary §4.13, payments §4.6, AI §4.12, Redis §4.15).

# ── Application ───────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Use the session-mode pooler: the direct host `db.[project-ref].supabase.co` publishes
# only an AAAA record, so it resolves on IPv6-capable hosts and fails elsewhere. Percent-
# encode the password (`#` → `%23`, `$` → `%24`); the transaction pooler (`:6543`) cannot
# run prepared statements, so keep `:5432`.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Direct connection — IPv6-only, so usable only where IPv6 resolves (some deploy hosts):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Tokens this API signs: access 7d, refresh 7d.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Email (Resend) — verification + invite mail ───────────────────────────────
# React Email templates rendered to HTML in `src/mail/templates/`.
RESEND_API_KEY=
RESEND_FROM=

# ── File storage (Cloudinary) — study material uploads ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments — Stripe (international) + SSLCommerz (Bangladesh) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# ── AI assistant + BullMQ/Redis queue (email + reminders) ─────────────────────
AI_API_KEY=
REDIS_URL=
